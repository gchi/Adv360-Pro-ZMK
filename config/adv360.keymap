#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp ESCAPE            &kp N1            &kp N2    &kp N3    &kp N4     &kp N5  &kp C_PLAY_PAUSE                                                  &kp EQUAL      &kp N6  &kp N7  &kp N8     &kp N9    &kp N0    &kp MINUS
&kp GRAVE             &kp Q             &kp W     &kp E     &kp R      &kp T   &kp C_VOLUME_UP                                                   &kp PAGE_UP    &kp Y   &kp U   &kp I      &kp O     &kp P     &kp BSLH
&kp TAB               &kp A             &kp S     &kp D     &kp F      &kp G   &kp C_VOLUME_DOWN  &to 4          &mo 3      &mo 3  &kp UP_ARROW  &kp PAGE_DOWN  &kp H   &kp J   &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT             &kp Z             &kp X     &kp C     &kp V      &kp B                                     &mo 2      &mo 2                               &kp N   &kp M   &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
&kp LC(LEFT_CONTROL)  &kp LA(LEFT_ALT)  &kp CAPS  &kp LEFT  &kp RIGHT          &kp LEFT_COMMAND   &kp BACKSPACE  &mo 1      &mo 1  &kp ENTER     &kp SPACE              &kp UP  &kp DOWN   &kp LBKT  &kp RBKT  &kp RIGHT_COMMAND
            >;
        };

        mouse {
            bindings = <
&trans  &trans          &trans        &trans     &trans  &trans  &trans                                         &trans     &trans          &trans          &trans          &trans           &trans  &trans
&trans  &trans          &kp UP_ARROW  &trans     &trans  &trans  &trans                                         &trans     &trans          &msc SCRL_DOWN  &msc SCRL_LEFT  &msc SCRL_RIGHT  &trans  &trans
&trans  &kp LEFT_ARROW  &kp DOWN      &kp RIGHT  &trans  &trans  &trans  &trans  &trans      &trans  &trans     &trans     &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP    &mmv MOVE_RIGHT  &trans  &trans
&trans  &trans          &trans        &trans     &trans  &trans                  &trans      &trans                        &trans          &msc SCRL_DOWN  &trans          &trans           &trans  &trans
&trans  &trans          &trans        &trans     &trans          &trans  &trans  &trans      &trans  &mkp RCLK  &mkp LCLK                  &trans          &trans          &trans           &trans  &trans
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &trans                                                   &mo 0      &kp N6  &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                                    &none      &kp Y   &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &kp BSLH
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &none     &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &none      &kp H   &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                        &kp HOME      &kp PG_UP                        &kp N   &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &kp RSHFT
&mo 3      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &kp KP_N0          &kp UP      &kp DOWN      &kp KP_DOT     &kp RBKT         &mo 3
            >;
        };

        media {
            display-name = "Fn";
            bindings = <
&none   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans                                          &bootloader  &trans  &trans      &trans            &trans        &trans  &trans
&trans  &trans        &bl BL_INC    &trans        &bootloader   &trans        &none                                           &none        &trans  &trans      &trans            &trans        &trans  &trans
&trans  &trans        &bl BL_DEC    &trans        &trans        &trans        &none   &trans  &trans      &trans  &bl BL_INC  &none        &trans  &kp C_PREV  &kp C_PLAY_PAUSE  &kp C_NEXT    &trans  &trans
&trans  &trans        &bt BT_CLR    &trans        &trans        &bl BL_TOG                    &trans      &trans                           &trans  &kp K_MUTE  &kp C_VOL_DN      &kp C_VOL_UP  &trans  &trans
&trans  &trans        &trans        &trans        &trans                      &trans  &trans  &trans      &trans  &trans      &trans               &trans      &bl BL_DEC        &trans        &trans  &trans
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                         &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                         &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                     &trans      &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &kp LCTRL  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
